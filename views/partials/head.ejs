<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f8fc">
  <title><%= title %> · Easily</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/styles.css">
</head>
<body>
<header class="site-header">
  <div class="nav-wrap">
    <a class="brand" href="/" aria-label="Easily home"><span class="brand-mark">e</span><span>easily<span class="brand-dot">.</span></span></a>
    <nav class="main-nav" aria-label="Main navigation">
      <a class="nav-link <%= currentPath.startsWith('/jobs') ? 'active' : '' %>" href="/jobs">Find jobs</a>
      <% if (currentUser) { %>
        <a class="nav-link" href="/jobs/new">Post a job</a>
        <span class="welcome">Hi, <%= currentUser.name.split(' ')[0] %></span>
        <form action="/logout" method="post"><button class="nav-login" type="submit">Log out</button></form>
      <% } else { %>
        <a class="nav-login" href="/login">Log in</a>
        <a class="button button-primary button-small" href="/register">For employers</a>
      <% } %>
    </nav>
  </div>
</header>
<main>
