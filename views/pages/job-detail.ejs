<%- include('../partials/head', { title }) %>
<section class="detail-wrap"><a class="back-link" href="/jobs">← &nbsp; All opportunities</a><div class="detail-layout"><article class="detail-main"><div class="detail-heading"><span class="company-avatar avatar-2 large-avatar"><%= job.companyname.trim().charAt(0).toUpperCase() %></span><div><span class="section-kicker"><%= job.jobcategory %></span><h1><%= job.jobdesignation %></h1><p class="company-line"><%= job.companyname %><span>·</span><%= job.joblocation %></p></div></div><div class="detail-stats"><div><span>COMPENSATION</span><strong><%= job.salary %></strong></div><div><span>OPEN POSITIONS</span><strong><%= job.numberofopenings %></strong></div><div><span>APPLY BY</span><strong><%= new Date(job.applyby).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong></div></div><div class="detail-section"><h2>A little about the role</h2><p>We’re looking for a <%= job.jobdesignation %> to join the team at <%= job.companyname %>. This is an opportunity to do thoughtful work with good people in <%= job.joblocation %>.</p></div><% if (job.skillsrequired.length) { %><div class="detail-section"><h2>What will help you thrive</h2><div class="skill-list"><% job.skillsrequired.forEach(skill => { %><span class="skill-tag"><%= skill %></span><% }); %></div></div><% } %><div class="detail-section"><h2>Ready for your next chapter?</h2><p>Tell us a little about yourself and attach your resume to apply.</p></div></article><aside class="apply-panel"><span class="section-kicker">MAKE YOUR MOVE</span><h2>This could be the one.</h2><p>Your application goes straight to the team hiring for this role.</p><% if (errors && errors.length) { %><div class="alert alert-error"><% errors.forEach(error => { %><p><%= error %></p><% }); %></div><% } %><form action="/apply/<%= job.id %>" method="post" enctype="multipart/form-data" class="stack-form"><label>Your name<input name="name" placeholder="Jordan Lee" required autocomplete="name"></label><label>Email address<input type="email" name="email" placeholder="you@email.com" required autocomplete="email"></label><label>Phone number<input type="tel" name="contact" placeholder="+1 555 123 4567" required autocomplete="tel"></label><label class="file-label">Resume <span class="optional-note">PDF, DOC, or DOCX · up to 5 MB</span><input type="file" name="resume" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required></label><button class="button button-primary button-full" type="submit">Send my application <span>→</span></button></form><p class="privacy-note">By applying, you agree to share your details with <%= job.companyname %>.</p><% if (currentUser && currentUser.id === job.recruiterId) { %><div class="owner-tools"><a href="/jobs/<%= job.id %>/update">Edit listing</a><a href="/jobs/<%= job.id %>/applicants">View applicants (<%= job.applicants.length %>)</a></div><% } %></aside></div></section>
<%- include('../partials/foot') %>
