<%- include('../partials/head', { title }) %>
<section class="page-intro"><div class="page-intro-inner"><span class="section-kicker">YOUR NEXT CHAPTER STARTS HERE</span><h1>Find work that <span class="text-accent">fits.</span></h1><p>Thoughtful opportunities from teams looking for someone like you.</p>
<form class="search-form listing-search" action="/jobs" method="get"><span class="search-icon" aria-hidden="true">⌕</span><label class="visually-hidden" for="q">Search jobs</label><input id="q" name="q" value="<%= search %>" placeholder="Try a role, company, or skill"><button class="button button-primary" type="submit">Search <span>→</span></button></form>
<div class="result-meta"><span><strong><%= total %></strong> <%= total === 1 ? 'opportunity' : 'opportunities' %><% if (search) { %> for “<%= search %>”<% } %></span><% if (search) { %><a class="clear-search" href="/jobs">Clear search ×</a><% } %></div></div></section>
<section class="job-list-section"><div class="job-grid">
<% if (jobs.length) { jobs.forEach((job, index) => { %>
<article class="job-card"><div class="job-card-top"><span class="company-avatar avatar-<%= index % 5 %>"><%= job.companyname.trim().charAt(0).toUpperCase() %></span><span class="job-category"><%= job.jobcategory %></span><% if (currentUser && job.recruiterId === currentUser.id) { %><span class="owner-label">Your listing</span><% } %></div><h2><a href="/jobs/<%= job.id %>"><%= job.jobdesignation %></a></h2><div class="company-line"><%= job.companyname %><span>·</span><%= job.joblocation %></div><div class="job-details"><span>↗ &nbsp;<%= job.salary %></span><span>◷ &nbsp;<%= job.numberofopenings %> <%= job.numberofopenings === 1 ? 'opening' : 'openings' %></span></div><% if (job.skillsrequired.length) { %><div class="skill-list"><% job.skillsrequired.slice(0, 4).forEach(skill => { %><span class="skill-tag"><%= skill %></span><% }); %></div><% } %><div class="job-card-bottom"><span class="posted-date">Posted <%= new Date(job.jobposted).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></span><a class="card-arrow" href="/jobs/<%= job.id %>" aria-label="View <%= job.jobdesignation %>">↗</a></div></article>
<% }); } else { %><div class="empty-state"><span class="empty-icon">⌕</span><h2>No roles found just yet.</h2><p><%= search ? 'Try a different search or clear your filters.' : 'New opportunities will feel right at home here. Check back soon.' %></p><% if (search) { %><a class="button button-outline" href="/jobs">Clear search</a><% } else if (currentUser) { %><a class="button button-primary" href="/jobs/new">Post the first job</a><% } %></div><% } %>
</div>
<% if (pages > 1) { %><nav class="pagination" aria-label="Job pages"><% if (page > 1) { %><a href="?q=<%= encodeURIComponent(search) %>&page=<%= page - 1 %>">← Previous</a><% } %><span>Page <%= page %> of <%= pages %></span><% if (page < pages) { %><a href="?q=<%= encodeURIComponent(search) %>&page=<%= page + 1 %>">Next →</a><% } %></nav><% } %>
</section>
<%- include('../partials/foot') %>
