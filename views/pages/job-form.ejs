<%- include('../partials/head', { title }) %>
<section class="form-page"><a class="back-link" href="/jobs">← &nbsp; Back to jobs</a><div class="form-page-heading"><span class="section-kicker">HELP THE RIGHT PERSON FIND YOU</span><h1><%= isEdit ? 'Bring your listing up to date.' : 'Let’s meet your next teammate.' %></h1><p>Give candidates a clear picture of the opportunity.</p></div><div class="form-card"><% if (errors.length) { %><div class="alert alert-error"><% errors.forEach(error => { %><p><%= error %></p><% }); %></div><% } %><form action="<%= formAction %>" method="post" class="job-form"><div class="form-grid"><label>Job title<input name="jobdesignation" value="<%= job.jobdesignation || '' %>" placeholder="e.g. Product designer" required maxlength="120"></label><label>Job category<input name="jobcategory" value="<%= job.jobcategory || '' %>" placeholder="e.g. Design & creative" required></label><label>Company name<input name="companyname" value="<%= job.companyname || '' %>" placeholder="Your company" required maxlength="120"></label><label>Location<input name="joblocation" value="<%= job.joblocation || '' %>" placeholder="City, country or Remote" required></label><label>Salary or range<input name="salary" value="<%= job.salary || '' %>" placeholder="e.g. $90k–$120k / year" required maxlength="100"></label><label>Application deadline<input type="date" name="applyby" value="<%= job.applyby ? String(job.applyby).slice(0, 10) : '' %>" required></label><label>Number of openings<input type="number" name="numberofopenings" value="<%= job.numberofopenings || 1 %>" min="1" step="1" required></label><label class="full-span">Skills <span class="optional-note">Separate each skill with a comma</span><input name="skillsrequired" value="<%= (job.skillsrequired || []).join(', ') %>" placeholder="e.g. Figma, Research, Prototyping"></label></div><div class="form-actions"><a class="button button-outline" href="/jobs">Cancel</a><button class="button button-primary" type="submit"><%= isEdit ? 'Save changes' : 'Publish job' %> <span>→</span></button></div></form></div></section>
<%- include('../partials/foot') %>
