<%- include('../partials/head', { title }) %>
<section class="auth-layout"><div class="auth-aside"><span class="section-kicker">GOOD PEOPLE MAKE GREAT WORK</span><h1>Let’s find<br>your <span class="text-accent">people.</span></h1><p>Start a conversation with the teammate you’ve been looking for.</p><div class="aside-ornament">✳</div></div><div class="auth-card"><span class="section-kicker">A BETTER WAY TO HIRE</span><h2>Create your account</h2><p class="form-subtitle">One small step toward your next great teammate.</p><% if (errors.length) { %><div class="alert alert-error"><% errors.forEach(error => { %><p><%= error %></p><% }); %></div><% } %><form action="/register" method="post" class="stack-form"><label>Your name<input name="name" value="<%= values.name || '' %>" placeholder="Jordan Lee" required minlength="2" maxlength="80" autocomplete="name"></label><label>Work email<input type="email" name="email" value="<%= values.email || '' %>" placeholder="you@company.com" required autocomplete="email"></label><label>Password<input type="password" name="password" placeholder="At least 8 characters" required minlength="8" autocomplete="new-password"></label><label>Confirm password<input type="password" name="confirmPassword" placeholder="Enter your password again" required autocomplete="new-password"></label><button class="button button-primary button-full" type="submit">Create account <span>→</span></button></form><p class="auth-switch">Already have an account? <a href="/login">Log in</a></p></div></section>
<%- include('../partials/foot') %>
