<%- include('../partials/head', { title }) %>
<section class="auth-layout"><div class="auth-aside"><span class="section-kicker">FOR THE PEOPLE WHO MAKE IT HAPPEN</span><h1>Find the right<br><span class="text-accent">people.</span></h1><p>Bring your next great teammate a little closer.</p><div class="aside-ornament">✳</div></div><div class="auth-card"><span class="section-kicker">WELCOME BACK</span><h2>Log in to Easily</h2><p class="form-subtitle">Manage your job listings and meet your next great hire.</p><% if (errors.length) { %><div class="alert alert-error"><% errors.forEach(error => { %><p><%= error %></p><% }); %></div><% } %><form action="/login" method="post" class="stack-form"><label>Email address<input type="email" name="email" value="<%= values.email || '' %>" placeholder="you@company.com" required autocomplete="email"></label><label>Password<input type="password" name="password" placeholder="Your password" required autocomplete="current-password"></label><button class="button button-primary button-full" type="submit">Log in <span>→</span></button></form><p class="auth-switch">New to Easily? <a href="/register">Create a recruiter account</a></p></div></section>
<%- include('../partials/foot') %>
