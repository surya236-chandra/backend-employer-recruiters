<%- include('../partials/head', { title }) %>
<section class="form-page applicants-page"><a class="back-link" href="/jobs/<%= job.id %>">← &nbsp; Back to listing</a><div class="form-page-heading"><span class="section-kicker">YOUR PEOPLE ARE HERE</span><h1>Applicants for <span class="text-accent"><%= job.jobdesignation %>.</span></h1><p><%= job.companyname %> · <%= applicants.length %> <%= applicants.length === 1 ? 'application' : 'applications' %></p></div><div class="form-card applicant-card"><% if (applicants.length) { %><div class="table-wrap"><table><thead><tr><th>Applicant</th><th>Contact</th><th>Applied</th><th>Resume</th></tr></thead><tbody><% applicants.forEach(applicant => { %><tr><td><strong><%= applicant.name %></strong></td><td><a href="mailto:<%= applicant.email %>"><%= applicant.email %></a><br><span class="muted"><%= applicant.contact %></span></td><td><%= new Date(applicant.appliedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td><td><a class="text-link" href="<%= applicant.resumePath %>" target="_blank" rel="noopener">View resume ↗</a></td></tr><% }); %></tbody></table></div><% } else { %><div class="empty-state compact-empty"><span class="empty-icon">✳</span><h2>Good people take their time.</h2><p>When applications arrive, you’ll find them right here.</p></div><% } %></div></section>
<%- include('../partials/foot') %>
